pipeline {
  agent {
    kubernetes {
      yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins-kaniko-agent
  containers:
    - name: tools
      image: alpine:3.20
      command:
        - cat
      tty: true
"""
    }
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    booleanParam(name: 'RUN_TESTS', defaultValue: true, description: '로컬 Debezium connector JSON 예제를 검증합니다.')
  }

  environment {
    JENKINS_AGENT_SERVICE_ACCOUNT = 'jenkins-kaniko-agent'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Validate') {
      when { expression { return params.RUN_TESTS } }
      steps {
        container('tools') {
          sh '''
            set -eu
            apk add --no-cache jq

            for file in debezium/*.json; do
              jq -e '.name and .config["connector.class"] and .config["transforms.outbox.type"]' "$file" >/dev/null
            done
          '''
        }
      }
    }
  }
}
